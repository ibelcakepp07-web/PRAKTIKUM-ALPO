import time

# Catat waktu dimulai
waktu_mulai = time.perf_counter()

# KODE YANG INGIN DIUKUR
total = 0
for i in range(100_000_000):
    total += i  # Gunakan '+ i' jika ingin hasil 49999995000000

# Catat waktu selesai
waktu_selesai = time.perf_counter()

# Hitung selisih waktu (waktu selesai dikurangi waktu mulai)
lama_eksekusi = waktu_selesai - waktu_mulai

print(f"Total perhitungan : {total}")
print(f"Lama waktu eksekusi : {lama_eksekusi:.6f} detik")